<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.barcodemate</groupId>
  <artifactId>zxing-extended</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>barcodemate-zxing-extended</name>
  <description>ZXing Java 3.5.4 的派生作品，补齐 ZXing-C++ 支持而 ZXing Java 缺失的条码格式解码能力。由 barcodemate.com 发布。</description>
  <url>https://barcodemate.com/</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>BarcodeMate</name>
      <url>https://barcodemate.com</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/barcodemate/barcodemate-zxing-extended</url>
    <connection>scm:git:https://github.com/barcodemate/barcodemate-zxing-extended.git</connection>
    <developerConnection>scm:git:git@github.com:barcodemate/barcodemate-zxing-extended.git</developerConnection>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/barcodemate/barcodemate-zxing-extended/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <!-- 上游基线，见 README 与 NOTICE -->
    <baseline.zxing.java>zxing-3.5.4</baseline.zxing.java>
    <baseline.zxing.cpp>v3.1.1</baseline.zxing.cpp>
    <zxing.blackbox.base>${project.basedir}/upstream-zxing-java/core</zxing.blackbox.base>
    <zxing.cpp.samples.base>${project.basedir}/upstream-zxing-cpp/test/samples</zxing.cpp.samples.base>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!--
            上游 blackbox 图片集（132MB）不纳入本仓库。默认指向本地上游检出；
            不存在时相关用例自动跳过（见 AbstractBlackBoxTestCase.buildTestBase）。
            其他检出位置用 -Dzxing.blackbox.base=<上游 zxing 检出的 core 目录> 覆盖。
          -->
          <systemPropertyVariables>
            <zxing.blackbox.base>${zxing.blackbox.base}</zxing.blackbox.base>
            <zxing.cpp.samples.base>${zxing.cpp.samples.base}</zxing.cpp.samples.base>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>


  <profiles>
    <!--
      Everything Maven Central requires beyond an ordinary build: sources and
      javadoc jars, and a GPG signature over all of them. Kept in a profile so
      that an ordinary `mvn test` needs no signing key.

      Activate with -Prelease. See RELEASING.md for the rest.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!-- The imported upstream sources predate several javadoc
                   strictness rules; failing a release over them would mean
                   editing upstream code to satisfy a linter. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- The Central publishing plugin takes over the deploy step; the
                 stock deploy plugin would look for a distribution repository
                 that does not exist. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <version>3.1.4</version>
            <configuration>
              <skip>true</skip>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <!--
              0.7.0 uploads correctly but then fails parsing the server's
              response, which has since grown a "warnings" field the older
              client rejects. The upload had already succeeded, so the build
              failed after the work was done, which is a confusing place to
              leave a release. This version understands the response.
            -->
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Uploaded but not released, so the contents can be checked
                   before anything becomes permanent. A Central publication
                   cannot be withdrawn once released. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
